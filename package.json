{
  "name": "doodle-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.15.0"
  },
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run test && npm run format:check && npm run build",
    "signal": "node scripts/signaling.js"
  },
  "dependencies": {
    "lxgw-wenkai-screen-webfont": "1.7.0",
    "peerjs": "1.5.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "globals": "16.5.0",
    "peer": "1.0.2",
    "prettier": "3.9.6",
    "vite": "6.4.3"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
